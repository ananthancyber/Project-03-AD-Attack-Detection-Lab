tml=1;fontSize=13;fontStyle=1;fontColor=#FDA4AF;align=center;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="740" y="230" width="290" height="25" as="geometry"/></mxCell><mxCell id="endTraffic" value="Attack traffic: SMB / NTLM" style="text;html=1;fontSize=13;fontStyle=1;fontColor=#FDA4AF;align=center;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="740" y="445" width="260" height="25" as="geometry"/></mxCell><mxCell id="tel1" value="Telemetry via Wazuh agents" style="text;html=1;fontSize=12;fontStyle=1;fontColor=#7DD3FC;align=center;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="1390" y="325" width="175" height="20" as="geometry"/></mxCell><mxCell id="tel2" value="Telemetry via Wazuh agents" style="text;html=1;fontSize=12;fontStyle=1;fontColor=#7DD3FC;align=center;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="1390" y="405" width="175" height="20" as="geometry"/></mxCell>
<mxCell id="scenarios" value="03  CONTROLLED SECURITY SCENARIOS | Days 06 to 12" style="rounded=0;html=1;fillColor=#251821;strokeColor=#9F4560;strokeWidth=2;fontColor=#FFE4E6;fontSize=19;fontStyle=1;align=left;spacingLeft=25;verticalAlign=top;spacingTop=25;" vertex="1" parent="1"><mxGeometry x="60" y="545" width="1190" height="360" as="geometry"/></mxCell><mxCell id="s1" value="Day 06  Kerberoasting&lt;br&gt;&lt;font style=&quot;font-size:13px&quot;&gt;Kerberos | Event 4769&lt;/font&gt;&lt;br&gt;&lt;br&gt;Day 07  NTLM unexpected source&lt;br&gt;&lt;font style=&quot;font-size:13px&quot;&gt;SMB / NTLM | 4624 + 4776&lt;/font&gt;&lt;br&gt;&lt;br&gt;Day 08  AS-REP Roasting&lt;br&gt;&lt;font style=&quot;font-size:13px&quot;&gt;Kerberos | Event 4768&lt;/font&gt;" style="text;html=1;fontSize=16;fontStyle=1;fontColor=#FFF1F2;align=left;verticalAlign=top;spacingLeft=35;spacingTop=88;" vertex="1" parent="1"><mxGeometry x="65" y="550" width="520" height="340" as="geometry"/></mxCell><mxCell id="s2" value="Day 09  Pass-the-Hash&lt;br&gt;&lt;font style=&quot;font-size:13px&quot;&gt;SMB / NTLM | Wazuh Rule 92652&lt;/font&gt;&lt;br&gt;&lt;br&gt;Day 10  DCSync&lt;br&gt;&lt;font style=&quot;font-size:13px&quot;&gt;DRSUAPI | 4662 | Rule 100005 logtest&lt;/font&gt;&lt;br&gt;&lt;br&gt;Day 11  BloodHound attack path&lt;br&gt;&lt;font style=&quot;font-size:13px&quot;&gt;LDAP | AD relationship analysis&lt;/font&gt;&lt;br&gt;&lt;br&gt;Day 12  SMB lateral authentication&lt;br&gt;&lt;font style=&quot;font-size:13px&quot;&gt;SMB / NTLM | 4624 | Rule 92657&lt;/font&gt;" style="text;html=1;fontSize=16;fontStyle=1;fontColor=#FFF1F2;align=left;verticalAlign=top;spacingLeft=40;spacingTop=65;" vertex="1" parent="1"><mxGeometry x="620" y="550" width="610" height="340" as="geometry"/></mxCell>
<mxCell id="investigation" value="04  DETECTION AND INVESTIGATION&lt;br&gt;&lt;br&gt;1. Establish a baseline&lt;br&gt;&lt;font style=&quot;font-size:13px&quot;&gt;Identity, authentication, normal activity&lt;/font&gt;&lt;br&gt;&lt;br&gt;2. Generate controlled telemetry&lt;br&gt;&lt;font style=&quot;font-size:13px&quot;&gt;Windows Security logs and Sysmon&lt;/font&gt;&lt;br&gt;&lt;br&gt;3. Detect and correlate&lt;br&gt;&lt;font style=&quot;font-size:13px&quot;&gt;PowerShell analysis and Wazuh where validated&lt;/font&gt;&lt;br&gt;&lt;br&gt;4. Investigate and report&lt;br&gt;&lt;font style=&quot;font-size:13px&quot;&gt;Account, source, host, baseline, MITRE, verdict&lt;/font&gt;" style="rounded=0;html=1;fillColor=#102B26;strokeColor=#15803D;strokeWidth=2;fontColor=#ECFDF5;fontSize=19;fontStyle=1;align=left;spacingLeft=25;spacingTop=25;verticalAlign=top;" vertex="1" parent="1"><mxGeometry x="1280" y="545" width="580" height="360" as="geometry"/></mxCell>
<mxCell id="note" value="Validation boundary: Rule 92652 and Rule 92657 produced documented Wazuh alerts. Rule 100005 was tested with wazuh-logtest. BloodHound is identity attack-path analysis, not a SIEM alert." style="rounded=0;html=1;fillColor=#1E293B;strokeColor=#64748B;strokeWidth=2;fontColor=#E2E8F0;fontSize=14;align=center;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="60" y="950" width="1800" height="66" as="geometry"/></mxCell>
